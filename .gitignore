# Build output
/bin/
*.test
*.out

# Data + cache artifacts (regenerated by `make all`)
/data/
/cache/
*.jsonl.tmp

# Local env
.env
config.local.env

# Python
python/.venv/
python/__pycache__/
**/*.pyc

# OS
.DS_Store

# agentic track runtime artifacts
agentic/checkouts/
agentic/tasks/*/checkout/
# Materialized SWE-bench repo checkouts are large (~150M) and regenerable from
# the dataset via materialize_swe.py + tasks/swe_selection.json. Keep the small
# task.json + _oracle (the durable task definition) tracked; ignore the big repo.
agentic/tasks/swe-*/repo/
*.pyc
__pycache__/

# Step-1 real-SWE runtime artifacts (regenerable / noise)
data_agentic/cache/
agentic/results/logs/
agentic/results/pred_*.jsonl
agentic/results/*.step1_*.json

# containerized-agent toolbox (built node+claude blob) + any local token file
agentic/.claude_toolbox/
*.oauth.env
.claude_oauth.env

# swebench image-build logs (noise, regenerable)
logs/build_images/

# report.py narrative — local artifact; canonical agentic results are data_agentic/RESULTS.md
RESULTS_AGENTIC.md

# offline-engine executed-oracle rebuild cache (executed.jsonl is the artifact)
agentic/results/labels/_executed_cache/
agentic/results/labels/resolved.jsonl
agentic/results/labels/judge.jsonl
agentic/results/calibration/
agentic/results/labels/implicit.jsonl

# Claude Code local hook logs
.claude/hook-logs/
