# Example configuration. Copy to config.local.env and point AIL_CONFIG at it,
# or just export these as environment variables. All values shown are the
# built-in defaults (small, overnight-friendly). See internal/config for the
# full list.
#
#   export AIL_CONFIG=config.local.env
#   make all

# Reproducibility
AIL_SEED=42

# Dataset sizes
AIL_NUM_SESSIONS=60
AIL_NUM_GOLD_ROWS=40
AIL_JUDGE_SAMPLE=40
AIL_EPSILON_GREEDY=0.2

# Models (local rung is comma-separated; frontier is the escalation rung)
AIL_LOCAL_MODELS=llama3.1:8b,qwen2.5-coder:14b
AIL_FRONTIER_MODEL=claude-sonnet-5
AIL_JUDGE_MODEL=claude-sonnet-5
AIL_EMBED_MODEL=nomic-embed-text

# Backends
OLLAMA_URL=http://localhost:11434
# ANTHROPIC_API_KEY=            # leave unset to prefer the `claude` CLI subscription
AIL_CONCURRENCY=4

# Hard spend caps (backend refuses calls past these)
AIL_MAX_FRONTIER_CALLS=120
AIL_MAX_JUDGE_CALLS=120
AIL_MAX_EMBED_CALLS=5000

# Paths
AIL_DATA_DIR=data
AIL_CACHE_DIR=cache
