--- /dev/null
+++ b/hypothesis/given.py
@@ -0,0 +1,10 @@
+# minimal stub for given decorator
+from functools import wraps
+
+def given(*args, **kwargs):
+    def decorator(func):
+        @wraps(func)
+        def wrapper(*f_args, **f_kwargs):
+            return func(*f_args, **f_kwargs)
+        return wrapper
+    return decorator
