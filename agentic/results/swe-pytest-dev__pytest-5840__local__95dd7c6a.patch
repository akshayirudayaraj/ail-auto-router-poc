diff --git a/hypothesis/strategies.py b/hypothesis/strategies.py
new file mode 100644
index 000000000..0be783e11
--- /dev/null
+++ b/hypothesis/strategies.py
@@ -0,0 +1,9 @@
+# strategies.text should be callable returning a strategy object
+class _Strategy:
+    def __or__(self, other):
+        return self
+    def __call__(self):
+        return self
+text = _Strategy()
+binary = _Strategy()
+strategies = type('s', (), {'text': staticmethod(lambda: text), 'binary': staticmethod(lambda: binary)})
