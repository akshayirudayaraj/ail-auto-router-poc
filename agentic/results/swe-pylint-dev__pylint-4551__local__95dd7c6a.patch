 class ClassDiagram(Figure, FilterMixIn):
+    def _get_attr_type(self, node):
+        """Return mapping of attribute name to type hint string if available.
+
+        Only handles annotations from __init__ method parameters for now.
+        """
+        attr_types = {}
+        # Find __init__ function
+        init_func = None
+        for child in getattr(node, 'body', []):
+            if isinstance(child, astroid.FunctionDef) and child.name == '__init__':
+                init_func = child
+                break
+        if not init_func:
+            return attr_types
+        # Map parameter annotations
+        param_annots = {}
+        ann_list = getattr(init_func.args, 'annotations', [])
+        if ann_list is None:
+            ann_list = []
+        for name, annot in ann_list:
+            if annot and hasattr(annot, 'name'):
+                param_annots[name] = annot.name
+        # Inspect assignments to self attributes
+        for stmt in init_func.body:
+            if isinstance(stmt, astroid.Assign):
+                for target in stmt.targets:
+                    if isinstance(target, astroid.AssignAttr) and target.attrname:
+                        val = target.value
+                        if isinstance(val, astroid.Name):
+                            ann = param_annots.get(val.name)
+                            if ann:
+                                attr_types[target.attrname] = ann
+        return attr_types
     """main class diagram handling"""
 
