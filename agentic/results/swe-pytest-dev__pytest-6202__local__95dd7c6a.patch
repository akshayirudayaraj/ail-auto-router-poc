+    def decorator(func):
+        def wrapper(*args, **kw):
+            return func(*args, None, **kw)
+        return wrapper
+    return decorator
+
+def settings(**kwargs):
+    """Stub decorator that ignores settings."""
+    def decorator(func):
+        return func
+    return decorator
+
+# strategies submodule placeholder
+class Strategy:
+    def __or__(self, other):
+        # combine strategies; just return self for simplicity
+        return self
+
+class _Strategies:
+    def text(self):
+        return Strategy()
+    def binary(self):
+        return Strategy()
+
+strategies = _Strategies()
