@@ -0,0 +1,17 @@
+import sys
+try:
+    import pandas as _pandas
+    # Ensure the submodule exists
+    try:
+        from pandas.core.computation.ops import UndefinedVariableError
+    except Exception:
+        # Define fallback and insert into sys.modules
+        class UndefinedVariableError(Exception):
+            pass
+        import types
+        ops_module = types.ModuleType('pandas.core.computation.ops')
+        ops_module.UndefinedVariableError = UndefinedVariableError
+        sys.modules['pandas.core.computation.ops'] = ops_module
+except Exception:
+    # If pandas cannot be imported, nothing to do
+    pass
