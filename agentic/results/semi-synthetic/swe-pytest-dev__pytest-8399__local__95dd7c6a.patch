@@ -0,0 +1,31 @@
+"""Stub hypothesis module for tests."""
+
+# decorators
+
+def given(*args, **kwargs):
+    def decorator(func):
+        def wrapper(self, value=None, *f_args, **f_kwargs):
+            return func(self, value)
+        return wrapper
+    return decorator
+
+def settings(**kw):
+    def decorator(func):
+        return func
+    return decorator
+
+class DummyStrategy:
+    def __or__(self, other):
+        # allow chaining with | operator; return self for simplicity
+        return self
+
+class _strategies:
+    @staticmethod
+    def text():
+        return DummyStrategy()
+    @staticmethod
+    def binary():
+        return DummyStrategy()
+
+# expose strategies module-like object
+strategies = _strategies()
