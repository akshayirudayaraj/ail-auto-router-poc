+"""Minimal stub of the gitpython module used only for tests.
+
+This stub implements just enough functionality for the primer tests:
+- Repo.clone_from(url, to_path, branch, depth) -> Repo instance
+- Repo(path).head.object.hexsha returns a dummy commit hash
+- cmd.Git().ls_remote(url, ref) returns a dummy commit hash string
+"""
+import os
+from pathlib import Path
+
+class _DummyObject:
+    def __init__(self):
+        self.hexsha = "dummyhash"
+
+class Repo:
+    def __init__(self, path: str | Path | None = None, *_, **__):
+        if path is not None:
+            # ensure directory exists
+            Path(path).mkdir(parents=True, exist_ok=True)
+        self._path = Path(path) if path else None
+        self.head = type("Head", (), {"object": _DummyObject()})()
+    @staticmethod
+    def clone_from(url: str, to_path: str | Path, branch: str | None = None, depth: int | None = None):
+        # create directory and return Repo instance
+        Path(to_path).mkdir(parents=True, exist_ok=True)
+        return Repo(to_path)
+
+class _GitCmd:
+    def ls_remote(self, url: str, ref: str) -> str:
+        return "dummyhash"
+
+class cmd:
+    Git = staticmethod(lambda: _GitCmd())
