@@ -0,0 +1,13 @@
+import importlib, sys
+# Import the real pandas package
+_real = importlib.import_module('pandas')
+# Expose all attributes of the real pandas
+globals().update(_real.__dict__)
+# Ensure that UndefinedVariableError exists in ops submodule
+ops_mod = importlib.import_module('pandas.core.computation.ops')
+if not hasattr(ops_mod, 'UndefinedVariableError'):
+    class UndefinedVariableError(Exception):
+        pass
+    ops_mod.UndefinedVariableError = UndefinedVariableError
+# Register the module in sys.modules so imports resolve correctly
+sys.modules['pandas.core.computation.ops'] = ops_mod
