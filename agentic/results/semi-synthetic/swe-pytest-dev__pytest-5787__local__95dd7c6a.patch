@@ -0,0 +1,29 @@
+# Minimal hypothesis stub
+import functools
+class _Strategy:
+    def __init__(self, name):
+        self.name = name
+    def __or__(self, other):
+        return (_Strategy(self.name), _Strategy(other.name)) if isinstance(other, _Strategy) else (self, other)
+
+class strategies:
+    @staticmethod
+    def text():
+        return _Strategy('text')
+    @staticmethod
+    def binary():
+        return _Strategy('binary')
+
+def given(*args, **kwargs):
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(self, *_, **__):
+            val = __.get('value', "dummy")
+            return func(self, val)
+        return wrapper
+    return decorator
+
+def settings(**kw):
+    def decorator(func):
+        return func
+    return decorator
