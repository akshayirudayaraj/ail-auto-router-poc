@@ -0,0 +1,31 @@
+# minimal hypothesis stub
+import functools
+
+class _Strategy:
+    def __or__(self, other):
+        return self
+
+    def __call__(self, func):
+        # decorator that returns function unchanged
+        return func
+
+# expose strategies module with text and binary functions returning strategy objects
+class strategies:
+    @staticmethod
+    def text():
+        return _Strategy()
+    @staticmethod
+    def binary():
+        return _Strategy()
+
+# decorators
+
+def given(*strategies):
+    def decorator(func):
+        return func
+    return decorator
+
+def settings(**kwargs):
+    def decorator(func):
+        return func
+    return decorator
