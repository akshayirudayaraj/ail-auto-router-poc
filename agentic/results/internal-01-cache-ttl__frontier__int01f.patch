+import time
+
+
 class TTLCache:
     """A tiny in-memory cache. Entries expire ttl_seconds after insertion."""

     def __init__(self, ttl_seconds=300):
         self._store = {}
+        self._inserted = {}
         self.ttl_seconds = ttl_seconds

     def set(self, key, value):
         self._store[key] = value
+        self._inserted[key] = time.monotonic()

     def get(self, key):
+        inserted = self._inserted.get(key)
+        if inserted is not None and time.monotonic() - inserted > self.ttl_seconds:
+            # Expired: evict from both maps and report a miss.
+            self._store.pop(key, None)
+            self._inserted.pop(key, None)
+            return None
         return self._store.get(key)

     def __len__(self):
         return len(self._store)
